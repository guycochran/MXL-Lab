# Optional second isolated NDI-to-MXL input for two-real-source Core gates.
# Copy to env.core-ingress-b and set either NDI_SRC or NDI_URL.
NDI_SRC=
NDI_URL=

# This service publishes the pilot's second video input. Give audio a separate
# UUID even when the selected NDI source currently carries video only.
FLOW_A=4d584c10-2002-4c10-8000-000000000002
FLOW_B=4d584c10-2005-4c10-8000-000000000005
FLOW_AUDIO=4d584c10-2004-4c10-8000-000000000004

MXL_DOMAIN=/dev/shm/mxl/domain_ndi_lab
MXL_HISTORY_DURATION_NS=1000000000

SRC_AUTO=false
SRC_W=1920
SRC_H=1080
SRC_FPS=30000/1001
ENABLE_AUDIO=false
OUT_W=1080
OUT_H=1920
SCALER=lanczos
GST_DEBUG=2
PREVIEW_FPS=0
NDI_DISCOVERY=mdns
UBUNTU_VERSION=24.04

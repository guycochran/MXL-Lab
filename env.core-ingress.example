# Isolated NDI-to-MXL adapter configuration for MXL Switcher Core testing.
# Copy to env.core-ingress and set either NDI_SRC or NDI_URL before starting.
NDI_SRC=
NDI_URL=

# Pilot-owned UUIDs. These must not overlap production or synthetic test flows.
FLOW_A=4d584c10-2001-4c10-8000-000000000001
FLOW_B=4d584c10-2002-4c10-8000-000000000002
FLOW_AUDIO=4d584c10-2003-4c10-8000-000000000003

# Never point the pilot at the shared parent /dev/shm/mxl.
MXL_DOMAIN=/dev/shm/mxl/domain_ndi_lab

SRC_AUTO=true
SRC_W=1920
SRC_H=1080
OUT_W=1080
OUT_H=1920
SRC_FPS=30000/1001
SCALER=lanczos
GST_DEBUG=2
PREVIEW_FPS=0
NDI_DISCOVERY=mdns
UBUNTU_VERSION=24.04

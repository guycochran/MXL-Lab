# Isolated MXL Switcher Core-to-NDI output configuration.
MXL_DOMAIN=/dev/shm/mxl/domain_ndi_lab

# Stable output flows created once by MXL Switcher Core.
PROGRAM_FLOW=4d584c10-3001-4c10-8000-000000000001
PREVIEW_FLOW=4d584c10-3002-4c10-8000-000000000002

# Names advertised to NDI receivers on the media network.
PROGRAM_NDI_NAME=MXL Switcher Program
PREVIEW_NDI_NAME=MXL Switcher Preview

GST_DEBUG=2
NDI_DISCOVERY=mdns
UBUNTU_VERSION=24.04
